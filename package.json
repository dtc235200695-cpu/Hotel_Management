{
  "name": "hotelcloud",
  "version": "1.0.0",
  "description": "HotelCloud - Hệ thống quản lý khách sạn trên nền tảng điện toán đám mây",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/server.js\" \"vite --port 3000\"",
    "dev:server": "node server/server.js",
    "dev:client": "vite --port 3000",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "start": "node server/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0",
    "wrangler": "^3.109.0"
  }
}
